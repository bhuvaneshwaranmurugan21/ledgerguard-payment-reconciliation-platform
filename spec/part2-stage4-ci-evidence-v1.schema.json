{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ledgerguard:part2-stage4-ci-evidence:v1",
  "title": "LedgerGuard Part 2 Stage 4 exact-head CI evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "repository", "commit_sha", "checked_out_sha", "base_sha",
    "workflow_run_id", "workflow_run_attempt", "pull_request_number", "pull_request_draft",
    "python_version", "clean_run_count", "deterministic_equal", "deterministic_payload_sha256",
    "stage4_candidate_digest", "wheel_sha256", "test_counts", "coverage_percent",
    "coverage_statements", "coverage_branches", "mutation_checks", "mutation_survivors",
    "stage3_closure_commit", "stage3_external_state", "aws_execution", "aws_api_called",
    "aws_workflow_dispatched", "infrastructure_mutation", "production_reconciliation_executed",
    "authoritative_proof_persisted", "merge_authorized"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "repository": {"const": "bhuvaneshwaranmurugan21/ledgerguard-payment-reconciliation-platform"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "checked_out_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_sha": {"const": "47e96d3f4846d55568c0b137fb3e4d41ead0eef1"},
    "workflow_run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "workflow_run_attempt": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "pull_request_number": {"type": "integer", "minimum": 1},
    "pull_request_draft": {"const": true},
    "python_version": {"const": "3.11.13"},
    "clean_run_count": {"type": "integer", "minimum": 2},
    "deterministic_equal": {"const": true},
    "deterministic_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage4_candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "wheel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "test_counts": {"type": "object", "additionalProperties": false, "required": ["tests", "failures", "errors", "skipped"], "properties": {"tests": {"type": "integer", "minimum": 350}, "failures": {"const": 0}, "errors": {"const": 0}, "skipped": {"const": 0}}},
    "coverage_percent": {"const": 100.0},
    "coverage_statements": {"type": "integer", "minimum": 841},
    "coverage_branches": {"type": "integer", "minimum": 336},
    "mutation_checks": {"const": 20},
    "mutation_survivors": {"const": 0},
    "stage3_closure_commit": {"const": "47e96d3f4846d55568c0b137fb3e4d41ead0eef1"},
    "stage3_external_state": {"const": "EXTERNALLY_VERIFIED"},
    "aws_execution": {"const": false},
    "aws_api_called": {"const": false},
    "aws_workflow_dispatched": {"const": false},
    "infrastructure_mutation": {"const": false},
    "production_reconciliation_executed": {"const": true},
    "authoritative_proof_persisted": {"const": false},
    "merge_authorized": {"const": false}
  }
}
