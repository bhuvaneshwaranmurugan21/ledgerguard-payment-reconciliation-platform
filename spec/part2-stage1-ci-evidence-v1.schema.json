{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ledgerguard:part2-stage1-ci-evidence:v1",
  "title": "LedgerGuard Part 2 Stage 1 CI evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "commit_sha",
    "checked_out_sha",
    "base_sha",
    "workflow_run_id",
    "workflow_run_attempt",
    "pull_request_number",
    "pull_request_draft",
    "python_version",
    "java_major",
    "spark_version",
    "py4j_version",
    "clean_run_count",
    "deterministic_equal",
    "deterministic_payload_sha256",
    "stage1_candidate_digest",
    "part1_closure_commit",
    "spark_logical_digest",
    "test_counts",
    "aws_execution",
    "infrastructure_mutation"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "repository": {"const": "bhuvaneshwaranmurugan21/ledgerguard-payment-reconciliation-platform"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "checked_out_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "workflow_run_id": {"type": "string", "pattern": "^[0-9]+$"},
    "workflow_run_attempt": {"type": "string", "pattern": "^[0-9]+$"},
    "pull_request_number": {"type": "integer", "minimum": 10},
    "pull_request_draft": {"const": true},
    "python_version": {"const": "3.11.13"},
    "java_major": {"const": 17},
    "spark_version": {"const": "3.5.6"},
    "py4j_version": {"const": "0.10.9.7"},
    "clean_run_count": {"const": 2},
    "deterministic_equal": {"const": true},
    "deterministic_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage1_candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "part1_closure_commit": {"const": "3ef17666e3fe3bc655ba1c8733beb3cb00acdbec"},
    "spark_logical_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "test_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "failures", "errors", "skipped"],
      "properties": {
        "tests": {"type": "integer", "minimum": 260},
        "failures": {"const": 0},
        "errors": {"const": 0},
        "skipped": {"const": 0}
      }
    },
    "aws_execution": {"const": false},
    "infrastructure_mutation": {"const": false}
  }
}
