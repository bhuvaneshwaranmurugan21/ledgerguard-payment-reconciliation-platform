    "pull_request_draft":{"const":true},
    "python_version":{"const":"3.11.13"},
    "java_major":{"const":17},
    "spark_version":{"const":"3.5.6"},
    "py4j_version":{"const":"0.10.9.7"},
    "clean_run_count":{"type":"integer","minimum":2},
    "deterministic_equal":{"const":true},
    "deterministic_payload_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "stage8_candidate_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "wheel_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "test_counts":{"type":"object","additionalProperties":false,"required":["tests","failures","errors","skipped"],"properties":{"tests":{"type":"integer","minimum":505},"failures":{"const":0},"errors":{"const":0},"skipped":{"const":0}}},
    "coverage_percent":{"const":100.0},
    "coverage_statements":{"type":"integer","minimum":1},
    "coverage_branches":{"type":"integer","minimum":1},
    "mutation_checks":{"const":14},
    "mutation_survivors":{"const":0},
    "stage7_closure_commit":{"const":"8fac3795ed0dac5284dd3b1595bd8fc9f6dc7344"},
    "stage7_external_state":{"const":"EXTERNALLY_VERIFIED"},
    "requirement_count":{"const":203},
    "stage_gate_count":{"const":69},
    "master_gate_count":{"const":6},
    "master_gates_external":{"const":true},
    "spark_reexecuted":{"const":true},
    "spark_authoritative":{"const":false},
    "aws_api_called":{"const":false},
    "aws_workflow_dispatched":{"const":false},
    "managed_persistence":{"const":false},
    "infrastructure_mutation":{"const":false},
    "part2_closed":{"const":false},
    "closure_attestation_required":{"const":true},
    "merge_authorized":{"const":false}
  }
}
