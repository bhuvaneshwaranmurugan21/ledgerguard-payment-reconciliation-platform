{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:ledgerguard:part2-stage8-ci-evidence:v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","repository","commit_sha","checked_out_sha","base_sha","workflow_run_id","workflow_run_attempt","pull_request_number","pull_request_draft","python_version","java_major","spark_version","py4j_version","clean_run_count","deterministic_equal","deterministic_payload_sha256","stage8_candidate_digest","wheel_sha256","test_counts","coverage_percent","coverage_statements","coverage_branches","mutation_checks","mutation_survivors","stage7_closure_commit","stage7_external_state","requirement_count","stage_gate_count","master_gate_count","master_gates_external","spark_reexecuted","spark_authoritative","aws_api_called","aws_workflow_dispatched","managed_persistence","infrastructure_mutation","part2_closed","closure_attestation_required","merge_authorized"],
  "properties": {
