{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ledgerguard:reconciliation-policy:v1",
  "title": "LedgerGuard reconciliation policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "currency_exponents",
    "transaction_tolerance_minor",
    "settlement_tolerance_minor",
    "settlement_formula",
    "late_data_strategy"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy_version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "currency_exponents": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {"^[A-Z]{3}$": {"type": "integer", "minimum": 0, "maximum": 3}},
      "additionalProperties": false
    },
    "transaction_tolerance_minor": {
      "type": "object",
      "patternProperties": {"^[A-Z]{3}$": {"type": "integer", "minimum": 0}},
      "additionalProperties": false
    },
    "settlement_tolerance_minor": {
      "type": "object",
      "patternProperties": {"^[A-Z]{3}$": {"type": "integer", "minimum": 0}},
      "additionalProperties": false
    },
    "settlement_formula": {
      "const": "gross_minor-fee_minor-refund_minor-chargeback_minor-reserve_minor=expected_net_minor"
    },
    "late_data_strategy": {"const": "NEW_IMMUTABLE_REVISION"}
  }
}
