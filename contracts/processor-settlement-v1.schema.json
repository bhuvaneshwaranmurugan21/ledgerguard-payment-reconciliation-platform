{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ledgerguard:processor-settlement:v1",
  "title": "Processor settlement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_record_id",
    "source_batch_id",
    "processor",
    "merchant_id",
    "settlement_id",
    "settlement_cycle",
    "currency",
    "gross_minor",
    "fee_minor",
    "refund_minor",
    "chargeback_minor",
    "reserve_minor",
    "expected_net_minor",
    "occurred_at",
    "received_at",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_record_id": {"type": "string", "minLength": 1},
    "source_batch_id": {"type": "string", "minLength": 1},
    "processor": {"type": "string", "minLength": 1},
    "merchant_id": {"type": "string", "minLength": 1},
    "settlement_id": {"type": "string", "minLength": 1},
    "settlement_cycle": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "gross_minor": {"type": "integer", "minimum": 0},
    "fee_minor": {"type": "integer", "minimum": 0},
    "refund_minor": {"type": "integer", "minimum": 0},
    "chargeback_minor": {"type": "integer", "minimum": 0},
    "reserve_minor": {"type": "integer", "minimum": 0},
    "expected_net_minor": {"type": "integer"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
