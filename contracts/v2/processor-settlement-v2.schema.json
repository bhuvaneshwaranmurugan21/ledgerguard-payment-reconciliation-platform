{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ledgerguard:processor-settlement:v2",
  "title": "Processor settlement v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_record_id",
    "source_batch_id",
    "processor",
    "merchant_id",
    "settlement_id",
    "settlement_cycle",
    "currency",
    "gross_minor",
    "fee_minor",
    "refund_minor",
    "chargeback_minor",
    "reserve_minor",
    "reported_net_minor",
    "occurred_at",
    "received_at",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "source_record_id": {"$ref": "urn:ledgerguard:common:v2#/$defs/identifier"},
    "source_batch_id": {"$ref": "urn:ledgerguard:common:v2#/$defs/identifier"},
    "processor": {"$ref": "urn:ledgerguard:common:v2#/$defs/identifier"},
    "merchant_id": {"$ref": "urn:ledgerguard:common:v2#/$defs/identifier"},
    "settlement_id": {"$ref": "urn:ledgerguard:common:v2#/$defs/identifier"},
    "settlement_cycle": {"$ref": "urn:ledgerguard:common:v2#/$defs/identifier"},
    "currency": {"$ref": "urn:ledgerguard:common:v2#/$defs/supportedCurrency"},
    "gross_minor": {"$ref": "urn:ledgerguard:common:v2#/$defs/nonNegativeInt64"},
    "fee_minor": {"$ref": "urn:ledgerguard:common:v2#/$defs/nonNegativeInt64"},
    "refund_minor": {"$ref": "urn:ledgerguard:common:v2#/$defs/nonNegativeInt64"},
    "chargeback_minor": {"$ref": "urn:ledgerguard:common:v2#/$defs/nonNegativeInt64"},
    "reserve_minor": {"$ref": "urn:ledgerguard:common:v2#/$defs/nonNegativeInt64"},
    "reported_net_minor": {"$ref": "urn:ledgerguard:common:v2#/$defs/signedInt64"},
    "occurred_at": {"$ref": "urn:ledgerguard:common:v2#/$defs/utcTimestamp"},
    "received_at": {"$ref": "urn:ledgerguard:common:v2#/$defs/utcTimestamp"},
    "payload_sha256": {"$ref": "urn:ledgerguard:common:v2#/$defs/sha256"}
  }
}
