{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ledgerguard:bank-entry:v1",
  "title": "Bank statement entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bank_record_id",
    "source_batch_id",
    "bank_account_id",
    "merchant_id",
    "direction",
    "amount_minor",
    "currency",
    "value_at",
    "received_at",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "bank_record_id": {"type": "string", "minLength": 1},
    "source_batch_id": {"type": "string", "minLength": 1},
    "bank_account_id": {"type": "string", "minLength": 1},
    "merchant_id": {"type": "string", "minLength": 1},
    "settlement_reference": {"type": ["string", "null"], "minLength": 1},
    "direction": {"enum": ["CREDIT", "DEBIT"]},
    "amount_minor": {"type": "integer", "minimum": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "value_at": {"type": "string", "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
