{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ledgerguard:part3-stage3-candidate-manifest:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "attempt_id", "control_record_identity", "transaction_count", "settlement_count", "allocation_count", "logical_sha256", "physical_files", "authoritative_proof"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 8},
    "attempt_id": {"type": "string", "minLength": 8},
    "control_record_identity": {"type": "string", "minLength": 8},
    "transaction_count": {"type": "integer", "minimum": 0},
    "settlement_count": {"type": "integer", "minimum": 0},
    "allocation_count": {"type": "integer", "minimum": 0},
    "logical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "physical_files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"], "properties": {"path": {"type": "string"}, "size_bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "authoritative_proof": {"const": false}
  }
}
