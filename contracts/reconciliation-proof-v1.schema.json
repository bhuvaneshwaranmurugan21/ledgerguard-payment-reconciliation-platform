{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ledgerguard:reconciliation-proof:v1",
  "title": "LedgerGuard reconciliation proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_id",
    "run_id",
    "grain",
    "reconciliation_key",
    "revision",
    "currency",
    "policy_version",
    "source_manifest_sha256",
    "policy_sha256",
    "totals",
    "difference_minor",
    "status",
    "reason_codes",
    "created_at",
    "proof_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "proof_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 8},
    "grain": {"enum": ["TRANSACTION", "SETTLEMENT"]},
    "reconciliation_key": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "prior_proof_id": {"type": ["string", "null"], "minLength": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "policy_version": {"type": "string", "minLength": 1},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processor_minor", "ledger_minor", "bank_minor"],
      "properties": {
        "processor_minor": {"type": "integer"},
        "ledger_minor": {"type": "integer"},
        "bank_minor": {"type": "integer"}
      }
    },
    "difference_minor": {"type": "integer", "minimum": 0},
    "status": {"enum": ["MATCHED", "WITHIN_TOLERANCE", "EXCEPTION"]},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"},
    "proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
